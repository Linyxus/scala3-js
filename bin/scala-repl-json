#!/usr/bin/env bash

# Launch the Scala 3 JS REPL JSONL stdio worker.
# Reads one request object per stdin line and writes one response object per
# stdout line. sbt brings every artifact up to date on each launch — see
# bin/common-repl-js for the shared logic and rationale.

REPL_PROJECT="scala3-repl-json-sjs"
REPL_OPT="scala3-repl-json-opt"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" >& /dev/null && pwd)/common-repl-js"
