#!/usr/bin/env bash

# Launch the Scala 3 JS REPL JSONL stdio worker.
# Reads one request object per stdin line and writes one response object per
# stdout line. Rebuilds linked JS/runtime archives when missing.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" >& /dev/null && pwd)/.."

REPL_DIR="$ROOT/repl-js-json/target/scala3-repl-json-sjs"
CSJS_DIR="$ROOT/compiler-js-cli/target/scala3-compiler-cli-sjs"

MAIN_JS="$(find "$REPL_DIR" -name "main.js" -path "*fastopt*" 2>/dev/null | head -1)"
if [ -z "$MAIN_JS" ]; then
  echo "Building scala3-repl-json-sjs (fastLinkJS)..." >&2
  (cd "$ROOT" && sbt --client 'scala3-repl-json-sjs/fastLinkJS')
  MAIN_JS="$(find "$REPL_DIR" -name "main.js" -path "*fastopt*" 2>/dev/null | head -1)"
fi

export DOTTY_CLASSPATH_BIN="$(find "$CSJS_DIR" -name "classpath.bin" 2>/dev/null | head -1)"
export DOTTY_LINKER_LIBS_BIN="$(find "$CSJS_DIR" -name "linker-libs.bin" 2>/dev/null | head -1)"

if [ -z "$DOTTY_CLASSPATH_BIN" ] || [ -z "$DOTTY_LINKER_LIBS_BIN" ]; then
  echo "Building compiler runtime archives (packClasspath + packLinkerLibs)..." >&2
  (cd "$ROOT" && sbt --client 'scala3-compiler-cli-sjs/packClasspath' 'scala3-compiler-cli-sjs/packLinkerLibs')
  export DOTTY_CLASSPATH_BIN="$(find "$CSJS_DIR" -name "classpath.bin" 2>/dev/null | head -1)"
  export DOTTY_LINKER_LIBS_BIN="$(find "$CSJS_DIR" -name "linker-libs.bin" 2>/dev/null | head -1)"
fi

if [ -z "$MAIN_JS" ] || [ -z "$DOTTY_CLASSPATH_BIN" ] || [ -z "$DOTTY_LINKER_LIBS_BIN" ]; then
  echo "Error: missing main.js or bundled assets." >&2
  echo "  Run: sbt --client 'scala3-compiler-cli-sjs/packClasspath' 'scala3-compiler-cli-sjs/packLinkerLibs' 'scala3-repl-json-sjs/fastLinkJS'" >&2
  exit 1
fi

exec node "$MAIN_JS" "$@"
