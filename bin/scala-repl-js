#!/usr/bin/env bash

# Launch the Scala 3 REPL compiled to JavaScript via Scala.js.
# sbt brings every artifact up to date on each launch — see bin/common-repl-js
# for the shared logic and rationale.

REPL_PROJECT="scala3-repl-cli-sjs"
REPL_OPT="scala3-repl-cli-opt"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" >& /dev/null && pwd)/common-repl-js"
