#!/usr/bin/env bash

# Shared launch logic for the Scala.js REPL front-ends (bin/scala-repl-js and
# bin/scala-repl-json). Sourced, not executed: the caller sets two variables and
# then `source`s this file, which builds, locates artifacts, and execs node with
# the caller's own arguments ("$@").
#
#   REPL_PROJECT   sbt project that links the front-end main.js
#                  (e.g. scala3-repl-cli-sjs / scala3-repl-json-sjs)
#   REPL_FASTOPT   name of its fastopt output subdir
#                  (e.g. scala3-repl-cli-fastopt / scala3-repl-json-fastopt)
#
# Why always invoke sbt: the previous launchers only rebuilt when an artifact was
# *missing*, never when it was *stale*, so editing a compiler/repl source and
# re-launching silently ran old linked code (this bit us with a cc fix that was
# present in source but absent from the deployed main.js). Staleness across the
# whole graph — repl-js, library, compiler, compiler-js — is precisely what sbt's
# incremental compiler + Scala.js linker already track. So we make sbt the single
# source of truth: every launch asks it to bring all three artifacts up to date.
# With `sbt --client` the warm build server makes a no-op near-instant, and a
# build failure aborts the launch so node never runs against stale artifacts.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" >& /dev/null && pwd)/.."

if [ -z "$REPL_PROJECT" ] || [ -z "$REPL_FASTOPT" ]; then
  echo "common-repl-js: REPL_PROJECT and REPL_FASTOPT must be set before sourcing." >&2
  exit 1
fi

CSJS_DIR="$ROOT/compiler-js-cli/target/scala3-compiler-cli-sjs"

# Bring every artifact this front-end needs up to date in one round-trip. sbt
# no-ops whatever is already fresh. If anything fails to build, stop here rather
# than launch against stale/partial output.
echo "Ensuring REPL artifacts are up to date ($REPL_PROJECT)..." >&2
# Redirect sbt's logs to stderr: stdout is the REPL's own channel (a JSON
# protocol stream for the worker), and build chatter must not corrupt it.
if ! (cd "$ROOT" && sbt --client \
      "scala3-compiler-cli-sjs/packClasspath; scala3-compiler-cli-sjs/packLinkerLibs; $REPL_PROJECT/fastLinkJS" 1>&2); then
  echo "Error: sbt build failed; refusing to launch against stale artifacts." >&2
  exit 1
fi

MAIN_JS="$(find "$ROOT"/*/target -name "main.js" -path "*/$REPL_FASTOPT/*" 2>/dev/null | head -1)"
export DOTTY_CLASSPATH_BIN="$(find "$CSJS_DIR" -name "classpath.bin" 2>/dev/null | head -1)"
export DOTTY_LINKER_LIBS_BIN="$(find "$CSJS_DIR" -name "linker-libs.bin" 2>/dev/null | head -1)"

if [ -z "$MAIN_JS" ] || [ -z "$DOTTY_CLASSPATH_BIN" ] || [ -z "$DOTTY_LINKER_LIBS_BIN" ]; then
  echo "Error: build succeeded but an artifact is missing:" >&2
  echo "  main.js         = ${MAIN_JS:-<not found under $REPL_FASTOPT>}" >&2
  echo "  classpath.bin   = ${DOTTY_CLASSPATH_BIN:-<not found>}" >&2
  echo "  linker-libs.bin = ${DOTTY_LINKER_LIBS_BIN:-<not found>}" >&2
  exit 1
fi

exec node "$MAIN_JS" "$@"
