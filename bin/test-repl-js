#!/usr/bin/env bash
#
# Scripted-test harness for the Scala 3 JS REPL — the analogue of the JVM
# `ScriptedTests`/`ReplTest`. For each file in repl/test-resources/repl it replays
# the `scala>` lines through the JS REPL (`bin/scala-repl-js --script <file>`) and
# diffs the reproduced transcript against the file (non-blank lines, exact match).
#
# Usage:
#   bin/test-repl-js [FILTER]    # FILTER = substring of test file names to run
#
# Each test runs in its own `node` process, so the REPL session is freshly reset.

set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
DIR="$ROOT/repl/test-resources/repl"
EXCLUDES="$ROOT/repl-js/test/scripted-excludes.txt"
FILTER="${1:-}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Names listed in scripted-excludes.txt are platform-inherent limitations (see
# that file for per-test reasons); skip them but still report the count.
is_excluded() {
  [ -f "$EXCLUDES" ] || return 1
  grep -qE "^$1:" "$EXCLUDES"
}

pass=0
fail=0
skip=0
failed=()

for f in "$DIR"/*; do
  [ -f "$f" ] || continue
  name="$(basename "$f")"
  if [ -n "$FILTER" ] && [[ "$name" != *"$FILTER"* ]]; then continue; fi
  if [ -z "$FILTER" ] && is_excluded "$name"; then
    skip=$((skip + 1))
    printf 'SKIP %s\n' "$name"
    continue
  fi

  out="$TMP/$name.out"
  timeout 60 bash "$ROOT/bin/scala-repl-js" --script "$f" >"$out" 2>/dev/null

  if node "$ROOT/repl-js/test/compare.mjs" "$f" "$out"; then
    pass=$((pass + 1))
    printf 'PASS %s\n' "$name"
  else
    fail=$((fail + 1))
    failed+=("$name")
    printf 'FAIL %s\n' "$name"
  fi
done

echo
echo "==== $pass passed, $fail failed, $skip skipped (platform-inherent) ===="
if [ "$fail" -gt 0 ]; then
  printf '  %s\n' "${failed[@]}"
  exit 1
fi
