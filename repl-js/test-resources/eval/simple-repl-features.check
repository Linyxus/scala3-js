# simpleRepl: language-feature accumulation and typing/value behavior across
# session lines. Companion to simple-repl.check; brainstormed by a team of
# test-design agents (feature + typing lenses), curated by hand.

# givens accumulate: summon and implicit resolution at a using-def call.
>>> {"op": "eval", "code": "val f1 = simpleRepl[Int] { s => s.eval(\"given ten: Int = 10\"); s.eval(\"def ctxDouble(using n: Int) = n * 2\"); s.complete(s.eval[Int](\"summon[Int] + ctxDouble\")) }"}
~ "ok":true.*val f1: Int = 30

# extension methods accumulate; method-syntax lookup finds them lexically.
>>> {"op": "eval", "code": "val f2 = simpleRepl[Int] { s => s.eval(\"extension (n: Int) def squared = n * n\"); s.complete(s.eval[Int](\"7.squared\")) }"}
~ "ok":true.*val f2: Int = 49

# recursive def survives re-elaboration in later lines.
>>> {"op": "eval", "code": "val f3 = simpleRepl[Int] { s => s.eval(\"def fact(n: Int): Int = if n <= 1 then 1 else n * fact(n - 1)\"); s.complete(s.eval[Int](\"fact(5)\")) }"}
~ "ok":true.*val f3: Int = 120

# pattern-definition vals: both extracted names are captured.
>>> {"op": "eval", "code": "val f4 = simpleRepl[Int] { s => s.eval(\"val (a, b) = (6, 7)\"); s.complete(s.eval[Int](\"a * b\")) }"}
~ "ok":true.*val f4: Int = 42

# imports accumulate; a mutable object's identity persists across lines.
>>> {"op": "eval", "code": "val f5 = simpleRepl[Int] { s => s.eval(\"import scala.collection.mutable\"); s.eval(\"val buf = mutable.ListBuffer(1, 2, 3)\"); s.eval(\"buf += 4\"); s.complete(s.eval[Int](\"buf.sum\")) }"}
~ "ok":true.*val f5: Int = 10

# default arguments: defaulted and explicit calls from a later line.
>>> {"op": "eval", "code": "val f6 = simpleRepl[Int] { s => s.eval(\"def add(a: Int, b: Int = 10) = a + b\"); s.complete(s.eval[Int](\"add(5) + add(1, 2)\")) }"}
~ "ok":true.*val f6: Int = 18

# vararg def called from a later line.
>>> {"op": "eval", "code": "val f7 = simpleRepl[Int] { s => s.eval(\"def sumAll(xs: Int*) = xs.sum\"); s.complete(s.eval[Int](\"sumAll(1, 2, 3, 4)\")) }"}
~ "ok":true.*val f7: Int = 10

# curried def partially applied in one line, applied in the next.
>>> {"op": "eval", "code": "val f8 = simpleRepl[Int] { s => s.eval(\"def addc(a: Int)(b: Int) = a + b\"); s.eval(\"val add5 = addc(5)\"); s.complete(s.eval[Int](\"add5(37)\")) }"}
~ "ok":true.*val f8: Int = 42

# by-name parameter evaluates twice against the live var facade.
>>> {"op": "eval", "code": "val f9 = simpleRepl[Int] { s => s.eval(\"var hits = 0\"); s.eval(\"def twice(x: => Int) = x + x\"); s.eval(\"val t = twice({ hits += 1; hits })\"); s.complete(s.eval[Int](\"t * 10 + hits\")) }"}
~ "ok":true.*val f9: Int = 32

# lazy vals accumulate like plain vals.
>>> {"op": "eval", "code": "val f10 = simpleRepl[Int] { s => s.eval(\"lazy val lz = 21 * 2\"); s.complete(s.eval[Int](\"lz\")) }"}
~ "ok":true.*val f10: Int = 42

# case class defined AND used within one line works (classes just don't cross lines).
>>> {"op": "eval", "code": "val f11 = simpleRepl[Int] { s => s.complete(s.eval[Int](\"case class Point(x: Int, y: Int); val p = Point(3, 4); p.x * p.y\")) }"}
~ "ok":true.*val f11: Int = 12

# generic def instantiated at two types in a later line.
>>> {"op": "eval", "code": "val f12 = simpleRepl[Int] { s => s.eval(\"def pick[A](x: A, y: A, first: Boolean): A = if first then x else y\"); s.complete(s.eval[Int](\"pick(1, 2, false) + pick(\\\"ab\\\", \\\"xyz\\\", true).length\")) }"}
~ "ok":true.*val f12: Int = 4

# type aliases carry through the source chain.
>>> {"op": "eval", "code": "val f13 = simpleRepl[Int] { s => s.eval(\"type Pair = (Int, Int)\"); s.complete(s.eval[Int](\"val p: Pair = (20, 22); p._1 + p._2\")) }"}
~ "ok":true.*val f13: Int = 42

# same-line object with overloads (block-local overloads don't combine in Scala 3).
>>> {"op": "eval", "code": "val f14 = simpleRepl[Int] { s => s.complete(s.eval[Int](\"object Fmt { def f(a: Int) = a + 1; def f(str: String) = str.length }; Fmt.f(41) + Fmt.f(\\\"ab\\\")\")) }"}
~ "ok":true.*val f14: Int = 44

# renaming import: the selector's alias survives into the next line.
>>> {"op": "eval", "code": "val f15 = simpleRepl[Int] { s => s.eval(\"import scala.math.{max as maximum}\"); s.complete(s.eval[Int](\"maximum(40, 2) + 2\")) }"}
~ "ok":true.*val f15: Int = 42

# expected-type-driven literal widening to Long.
>>> {"op": "eval", "code": "val t1 = simpleRepl[Long] { s => s.complete(s.eval[Long](\"42\") * 1000000000L) }"}
~ "ok":true.*val t1: Long = 42000000000

# expected-type-driven constant narrowing to Byte.
>>> {"op": "eval", "code": "val t2 = simpleRepl[Byte] { s => s.complete(s.eval[Byte](\"1\")) }"}
~ "ok":true.*val t2: Byte = 1

# generic List crosses the boundary and supports .sum in driving code.
>>> {"op": "eval", "code": "val t3 = simpleRepl[Int] { s => val xs = s.eval[List[Int]](\"List(1, 2, 3)\"); s.complete(xs.sum) }"}
~ "ok":true.*val t3: Int = 6

# value from one line used with a type-directed lambda in the next; generic R.
>>> {"op": "eval", "code": "val t4 = simpleRepl[Option[Int]] { s => s.eval(\"val o = Some(41)\"); s.complete(s.eval[Option[Int]](\"o.map(_ + 1)\")) }"}
~ "ok":true.*val t4: Option.Int. = Some.42.

# a bare lambda types only via the spliced expected type; applied in driving code.
>>> {"op": "eval", "code": "val t5 = simpleRepl[Int] { s => val f = s.eval[Int => Int](\"x => x * 2\"); s.complete(f(21)) }"}
~ "ok":true.*val t5: Int = 42

# tuple type argument both as line T and through driving-code selection.
>>> {"op": "eval", "code": "val t6 = simpleRepl[String] { s => s.eval(\"val p = (1, \\\"two\\\")\"); s.complete(s.eval[(String, Int)](\"p.swap\")._1) }"}
~ "ok":true.*val t6: String = .*two

# null survives the boundary as a reference-typed value.
>>> {"op": "eval", "code": "val t7 = simpleRepl[String] { s => val v = s.eval[String](\"null\"); s.complete(if v == null then \"got-null\" else v) }"}
~ "ok":true.*val t7: String = .*got-null

# a trailing expression failing the T-ascription is a loud compile error; session continues.
>>> {"op": "eval", "code": "val t8 = simpleRepl[Int] { s => val bad = try s.eval[Int](\"\\\"abc\\\"\") catch { case _: scala.runtime.eval.EvalCompileException => -1 }; s.complete(bad + s.eval[Int](\"1\")) }"}
~ "ok":true.*val t8: Int = 0

# session result type inferred from the call site's expected type (no explicit [R]).
>>> {"op": "eval", "code": "val t9: Int = simpleRepl { s => s.complete(s.eval[Int](\"20 + 22\")) }"}
~ "ok":true.*val t9: Int = 42

# T = Any: cast is a no-op and the value keeps its runtime identity for matching.
>>> {"op": "eval", "code": "val t10 = simpleRepl[String] { s => val v = s.eval[Any](\"(40, 2)\"); s.complete(v match { case (a: Int, b: Int) => \"sum:\" + (a + b); case _ => \"other\" }) }"}
~ "ok":true.*val t10: String = .*sum:42

# union type renders through the sentinel's type argument.
>>> {"op": "eval", "code": "val t11 = simpleRepl[String] { s => val v = s.eval[Int | String](\"if true then 1 else \\\"two\\\"\"); s.complete(v match { case i: Int => \"int:\" + i; case str: String => \"str:\" + str }) }"}
~ "ok":true.*val t11: String = .*int:1

# intersection type renders as the line's T.
>>> {"op": "eval", "code": "val t12 = simpleRepl[Int] { s => val v = s.eval[Product & Serializable](\"(1, 2)\"); s.complete(v.productArity) }"}
~ "ok":true.*val t12: Int = 2

