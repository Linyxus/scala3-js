# Nested evalLoop: the inner loop completes and the outer uses its result.
>>> {"op":"eval","code":"val r = evalLoop[Int] { (ctx, s) => val inner = evalLoop[Int] { (c2, s2) => s2.complete(5) }; s.complete(inner * 2) }"}
~ "ok":true.*val r: Int = 10

# Inner and outer sessions have independent environments: a def in the inner
# session is not visible in the outer.
>>> {"op":"eval","code":"val r2 = evalLoop[Int] { (ctx, s) => evalLoop[Int] { (c2, s2) => s2.eval(\"val x = 1\"); s2.complete(0) }; s.complete(s.eval[Int](\"x\")) }"}
~ "ok":false
