# evalSafe is non-throwing: a compile failure becomes a Failure the driver can
# inspect and react to.
>>> {"op":"eval","code":"val r = embedRepl[Int] { s => val res = s.evalSafe[Int](\"nosuchname\"); s.complete(if (res.isFailure) -1 else 0) }"}
~ "ok":true.*val r: Int = -1

# The agentic retry shape: a bad line, then a good one, then complete.
>>> {"op":"eval","code":"val r2 = embedRepl[Int] { s => if (s.evalSafe[Int](\"oops\").isFailure) { val v = s.eval[Int](\"6 * 7\"); s.complete(v) } else s.complete(0) }"}
~ "ok":true.*val r2: Int = 42
