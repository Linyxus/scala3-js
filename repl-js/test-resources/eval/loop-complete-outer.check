# An inner loop's body can complete the OUTER loop via the captured outer `s`:
# the Break targets the outer boundary (by label) and unwinds through the inner.
>>> {"op":"eval","code":"val r = evalLoop[Int] { (ctx, s) => evalLoop[Int] { (c2, s2) => s.complete(99) }; s.complete(-1) }"}
~ "ok":true.*val r: Int = 99

# Completing the outer from inside the inner discards the inner's pending work.
>>> {"op":"eval","code":"val r2 = evalLoop[Int] { (ctx, s) => evalLoop[Int] { (c2, s2) => s2.eval(\"val tmp = 1\"); s.complete(7) }; s.complete(-1) }"}
~ "ok":true.*val r2: Int = 7
