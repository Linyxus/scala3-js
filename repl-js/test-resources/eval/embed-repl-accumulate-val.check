# Stateful session: defs from one s.eval line are visible to later lines (no
# re-execution — the prior line's wrapper persists and is imported).
>>> {"op":"eval","code":"val r = embedRepl[Int] { (ctx, s) => s.eval(\"val x = 10\"); val v = s.eval[Int](\"x * 2\"); s.complete(v) }"}
~ "ok":true.*val r: Int = 20

# A chain x -> y -> z across three lines.
>>> {"op":"eval","code":"val r2 = embedRepl[Int] { (ctx, s) => s.eval(\"val x = 1\"); s.eval(\"val y = x + 1\"); val v = s.eval[Int](\"val z = y + 1; z\"); s.complete(v) }"}
~ "ok":true.*val r2: Int = 3

# A later line sees ALL prior lines, not just the immediately preceding one.
>>> {"op":"eval","code":"val r3 = embedRepl[Int] { (ctx, s) => s.eval(\"val a = 2\"); s.eval(\"val b = 3\"); val v = s.eval[Int](\"a * b\"); s.complete(v) }"}
~ "ok":true.*val r3: Int = 6
