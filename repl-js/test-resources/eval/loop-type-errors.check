# complete's argument must conform to R.
>>> {"op":"eval","code":"evalLoop[Int] { (ctx, s) => s.complete(\"not an int\") }"}
~ "ok":false

# The body must have type Nothing — it cannot fall through without completing.
>>> {"op":"eval","code":"evalLoop[Int] { (ctx, s) => val x = 1 }"}
~ "ok":false

# An empty line is a compile error inside the loop.
>>> {"op":"eval","code":"val r = evalLoop[Int] { (ctx, s) => s.eval[Int](\"\"); s.complete(0) }"}
~ "ok":false
