# The session exposes embedded REPL progress. `attempts` counts the lines run so far.
>>> {"op":"eval","code":"val r = embedRepl[Int] { s => s.eval(\"1\"); s.eval(\"2\"); s.complete(s.attempts) }"}
~ "ok":true.*val r: Int = 2

# `lastError` is set after a failed line (via evalSafe, which does not throw).
>>> {"op":"eval","code":"val r2 = embedRepl[Boolean] { s => s.evalSafe[Int](\"nosuchname\"); s.complete(s.lastError.isDefined) }"}
~ "ok":true.*val r2: Boolean = true
