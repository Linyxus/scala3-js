# simpleRepl: term-level stateful eval built on one-shot eval chaining plus
# parser-stage line shaping (scala.runtime.eval.SimpleRepl +
# SpliceEvalBody.shapeSimpleReplLine). Auto-imported into every REPL line like
# eval/evalSafe/embedRepl. A line is any mix of definitions and statements;
# its value is its trailing expression (typed against the call's type
# argument) or () for definition-only lines.

# Accumulation across lines; statement lines need no trailing expression,
# with or without an explicit [Unit].
>>> {"op":"eval","code":"val r = simpleRepl[Int] { s => s.eval(\"val x = 10\"); s.eval[Unit](\"val y = x + 5\"); s.complete(s.eval[Int](\"x + y\")) }"}
~ "ok":true.*val r: Int = 25

# defs accumulate; a `; ()`-terminated statement line still works.
>>> {"op":"eval","code":"val r2 = simpleRepl[Int] { s => s.eval(\"def double(a: Int) = a * 2; ()\"); s.complete(s.eval[Int](\"double(21)\")) }"}
~ "ok":true.*val r2: Int = 42

# vars stay live across lines (VarRef facade): assign in one line, read later.
>>> {"op":"eval","code":"val r3 = simpleRepl[Int] { s => s.eval(\"var n = 3\"); s.eval(\"n += 4\"); s.complete(s.eval[Int](\"n\")) }"}
~ "ok":true.*val r3: Int = 7

# Shadowing is lexical nesting: a redefinition wins in later lines.
>>> {"op":"eval","code":"val r4 = simpleRepl[Int] { s => s.eval(\"val z = 1\"); s.eval(\"val z = 2\"); s.complete(s.eval[Int](\"z\")) }"}
~ "ok":true.*val r4: Int = 2

# Call-site locals of the enclosing statement are visible inside lines.
>>> {"op":"eval","code":"val r5 = locally { val k = 3; simpleRepl[Int] { s => s.complete(s.eval[Int](\"k * 2\")) } }"}
~ "ok":true.*val r5: Int = 6

# Lines see prior REPL top-level definitions, like one-shot eval.
>>> {"op":"eval","code":"val base = 100"}
~ "ok":true

>>> {"op":"eval","code":"val r6 = simpleRepl[Int] { s => s.complete(s.eval[Int](\"base + 1\")) }"}
~ "ok":true.*val r6: Int = 101

# A compile error in a line propagates as EvalCompileException and leaves the
# session state unchanged; the session continues.
>>> {"op":"eval","code":"val r7 = simpleRepl[Int] { s => s.eval(\"val a = 1\"); val bad = try s.eval[Int](\"a + nope\") catch { case _: scala.runtime.eval.EvalCompileException => -1 }; s.complete(bad + s.eval[Int](\"a\")) }"}
~ "ok":true.*val r7: Int = 0

# Nested sessions are independent; completion routes to the right boundary.
>>> {"op":"eval","code":"val r8 = simpleRepl[Int] { a => a.eval(\"val p = 5\"); val inner = simpleRepl[Int] { b => b.eval(\"val q = 7\"); b.complete(b.eval[Int](\"q + 1\")) }; a.complete(inner + a.eval[Int](\"p\")) }"}
~ "ok":true.*val r8: Int = 13

# Session fields: expectedType is the rendered R of the call site.
>>> {"op":"eval","code":"val r9 = simpleRepl[String] { s => s.complete(s.expectedType) }"}
~ "ok":true.*val r9: String = .*String

# Statement line ending with an expression: it runs, value discarded.
>>> {"op":"eval","code":"val r10 = simpleRepl[Int] { s => s.eval(\"var c = 0\"); s.eval(\"c += 1\\nc * 100\"); s.complete(s.eval[Int](\"c\")) }"}
~ "ok":true.*val r10: Int = 1

# A trailing if-expression is the line's value (tree-level shaping — no
# string-glue precedence caveats).
>>> {"op":"eval","code":"val r11 = simpleRepl[Int] { s => s.eval(\"val t = 3\"); s.complete(s.eval[Int](\"if t > 2 then 10 else 20\")) }"}
~ "ok":true.*val r11: Int = 10

# A definition-only line with a non-Unit type argument is a loud compile
# error (val __simpleReplLineValue__: Int = ()), not a silent value.
>>> {"op":"eval","code":"val r12 = simpleRepl[Int] { s => val bad = try s.eval[Int](\"val x = 1\") catch { case _: scala.runtime.eval.EvalCompileException => -1 }; s.complete(bad) }"}
~ "ok":true.*val r12: Int = -1
