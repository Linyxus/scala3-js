# Call-site locals are visible inside eval'd lines: the chain is rooted at the
# enclosing statement, so locals declared around the embedRepl call are in
# scope for every line (locals of the body lambda itself are not -- they sit
# inside the spliced-out call).
>>> {"op":"eval","code":"val r = { val k = 9; embedRepl[Int] { s => val v = s.eval[Int](\"k + 1\"); s.complete(v) } }"}
~ "ok":true.*val r: Int = 10

# A call-site local and an accumulated def together.
>>> {"op":"eval","code":"val r2 = { val k = 100; embedRepl[Int] { s => s.eval(\"val x = 5\"); val v = s.eval[Int](\"k + x\"); s.complete(v) } }"}
~ "ok":true.*val r2: Int = 105

# A captured `var` is read at its current value on each line (the VarRef facade
# reads the live var; the body mutates it between lines).
>>> {"op":"eval","code":"val r3 = { var k = 1; embedRepl[Int] { s => val a = s.eval[Int](\"k\"); k = 10; val b = s.eval[Int](\"k\"); s.complete(a * 100 + b) } }"}
~ "ok":true.*val r3: Int = 110
