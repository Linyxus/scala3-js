# evalLoop is generic in the result type R; complete carries an R.
>>> {"op":"eval","code":"val s1 = evalLoop[String] { (ctx, s) => s.complete(\"hi\") }"}
~ "ok":true.*val s1: String = .*hi

>>> {"op":"eval","code":"val l1 = evalLoop[List[Int]] { (ctx, s) => s.complete(List(1, 2, 3)) }"}
~ "ok":true.*val l1: List\[Int\] = List\(1, 2, 3\)

>>> {"op":"eval","code":"val o1 = evalLoop[Option[Int]] { (ctx, s) => s.complete(Some(7)) }"}
~ "ok":true.*val o1: Option\[Int\] = Some\(7\)

# Unit result (rendering of a Unit val is suppressed; just assert success).
>>> {"op":"eval","code":"val u1 = evalLoop[Unit] { (ctx, s) => s.complete(()) }"}
~ "ok":true
