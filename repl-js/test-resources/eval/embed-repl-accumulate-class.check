# A class defined in one line is usable (constructed) in a later line.
>>> {"op":"eval","code":"val r = embedRepl[Int] { s => s.eval(\"class Pt(val v: Int)\"); val v = s.eval[Int](\"new Pt(9).v\"); s.complete(v) }"}
~ "ok":true.*val r: Int = 9

# case class with field access across lines.
>>> {"op":"eval","code":"val r2 = embedRepl[Int] { s => s.eval(\"case class P(x: Int, y: Int)\"); val v = s.eval[Int](\"P(3, 4).y\"); s.complete(v) }"}
~ "ok":true.*val r2: Int = 4

# A class body referencing a prior `val`.
>>> {"op":"eval","code":"val r3 = embedRepl[Int] { s => s.eval(\"val base = 10\"); s.eval(\"class C { def g = base + 1 }\"); val v = s.eval[Int](\"new C().g\"); s.complete(v) }"}
~ "ok":true.*val r3: Int = 11
